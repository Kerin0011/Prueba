  "info": {
    "title": "FleetCore API — Gestión de Mantenimiento de Flota",
    "description": "API REST para la gestión del ciclo de vida de mantenimientos, vehículos, mecánicos y talleres de FleetCore.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "x-api-key": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Carlos Gómez"
          },
          "email": {
            "type": "string",
            "example": "carlos@fleetcore.com"
          },
          "password": {
            "type": "string",
            "example": "Tech12345!"
          },
          "role": {
            "type": "string",
            "enum": [
              "ADMIN",
              "TECHNICIAN"
            ],
            "default": "TECHNICIAN"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "admin@fleetcore.com"
          },
          "password": {
            "type": "string",
            "example": "Admin12345!"
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "CreateVehicleDto": {
        "type": "object",
        "properties": {
          "plate": {
            "type": "string",
            "example": "AAA111",
            "description": "Placa única del vehículo"
          },
          "brand": {
            "type": "string",
            "example": "Toyota"
          },
          "model": {
            "type": "string",
            "example": "Hilux"
          },
          "year": {
            "type": "number",
            "example": 2022
          },
          "mileage": {
            "type": "number",
            "example": 45000,
            "description": "Kilometraje actual"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "IN_MAINTENANCE",
              "INACTIVE"
            ],
            "default": "AVAILABLE"
          }
        },
        "required": [
          "plate",
          "brand",
          "model",
          "year",
          "mileage"
        ]
      },
      "UpdateVehicleDto": {
        "type": "object",
        "properties": {
          "plate": {
            "type": "string",
            "example": "AAA111",
            "description": "Placa única del vehículo"
          },
          "brand": {
            "type": "string",
            "example": "Toyota"
          },
          "model": {
            "type": "string",
            "example": "Hilux"
          },
          "year": {
            "type": "number",
            "example": 2022
          },
          "mileage": {
            "type": "number",
            "example": 45000,
            "description": "Kilometraje actual"
          },
          "status": {
            "type": "string",
            "enum": [
              "AVAILABLE",
              "IN_MAINTENANCE",
              "INACTIVE"
            ],
            "default": "AVAILABLE"
          }
        }
      },
      "CreateMechanicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Carlos Gómez"
          },
          "email": {
            "type": "string",
            "example": "carlos.gomez@fleetcore.com"
          },
          "specialty": {
            "type": "string",
            "example": "Motores Diésel"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE"
          },
          "userId": {
            "type": "string",
            "description": "ID del usuario asociado (rol TECHNICIAN)"
          }
        },
        "required": [
          "name",
          "email",
          "specialty"
        ]
      },
      "UpdateMechanicDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Carlos Gómez"
          },
          "email": {
            "type": "string",
            "example": "carlos.gomez@fleetcore.com"
          },
          "specialty": {
            "type": "string",
            "example": "Motores Diésel"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE"
          },
          "userId": {
            "type": "string",
            "description": "ID del usuario asociado (rol TECHNICIAN)"
          }
        }
      },
      "CreateWorkshopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Taller Central FleetCore"
          },
          "address": {
            "type": "string",
            "example": "Av. Industrial 450, Medellín"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE"
          }
        },
        "required": [
          "name",
          "address"
        ]
      },
      "UpdateWorkshopDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Taller Central FleetCore"
          },
          "address": {
            "type": "string",
            "example": "Av. Industrial 450, Medellín"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ],
            "default": "ACTIVE"
          }
        }
      },
      "CreateMaintenanceDto": {
        "type": "object",
        "properties": {
          "vehicleId": {
            "type": "string",
            "description": "ID del vehículo (UUID)"
          },
          "mechanicId": {
            "type": "string",
            "description": "ID del mecánico asignado (UUID)"
          },
          "workshopId": {
            "type": "string",
            "description": "ID del taller donde se realizará (UUID)"
          },
          "type": {
            "type": "string",
            "enum": [
              "PREVENTIVE",
              "CORRECTIVE"
            ],
            "example": "PREVENTIVE"
          },
          "description": {
            "type": "string",
            "example": "Mantenimiento preventivo general de 50.000 km"
          },
          "mileage": {
            "type": "number",
            "example": 45000,
            "description": "Kilometraje registrado para el mantenimiento"
          },
          "scheduledDate": {
            "type": "string",
            "example": "2026-11-01T08:00:00Z",
            "description": "Fecha y hora programada (ISO 8601)"
          }
        },
        "required": [
          "vehicleId",
          "mechanicId",
          "workshopId",
          "type",
          "description",
          "mileage",
          "scheduledDate"
        ]
      },
      "UpdateStatusDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "SCHEDULED",
              "IN_PROGRESS",
              "COMPLETED",
              "CANCELLED"
            ],
            "example": "IN_PROGRESS",
            "description": "Nuevo estado del mantenimiento (IN_PROGRESS, COMPLETED, CANCELLED)"
          },
          "workDone": {
            "type": "string",
            "example": "Reemplazo de pastillas de frenos y purga de líquido",
            "description": "Obligatorio si status es COMPLETED"
          },
          "finalCost": {
            "type": "number",
            "example": 450.5,
            "description": "Costo final del mantenimiento. Obligatorio si status es COMPLETED"
          },
          "completedDate": {
            "type": "string",
            "example": "2026-11-01T12:00:00Z",
            "description": "Fecha de finalización (ISO 8601). Obligatorio si status es COMPLETED"
          },
          "finalMileage": {
            "type": "number",
            "example": 45010,
            "description": "Kilometraje final al completar. Obligatorio si status es COMPLETED"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  }
}